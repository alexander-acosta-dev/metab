<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Definimos primero la acción -->
    <record id="action_import_products_wizard" model="ir.actions.act_window">
        <field name="name">Importar Productos desde API</field>
        <field name="res_model">product.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
    </record>

    <!-- Luego definimos los menús que usan esa acción -->
    <menuitem 
        id="menu_import_products_root" 
        name="Importar Productos" 
        parent="stock.menu_stock_root"
        sequence="10"/>
    
    <menuitem 
        id="menu_import_products_action" 
        name="Importar desde API" 
        parent="menu_import_products_root"
        action="action_import_products_wizard"/>
</odoo>