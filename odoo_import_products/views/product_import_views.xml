<odoo>
    <menuitem 
        id="menu_import_products" 
        name="Importar Productos" 
        parent="stock.menu_stock_root"
        sequence="100"
        action="action_import_products"/>
        
    <record id="action_import_products" model="ir.actions.server">
        <field name="name">Importar Productos desde API</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
            action = model.search([]).import_products_from_api()
        </field>
    </record>
</odoo>