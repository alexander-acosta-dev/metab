<odoo>
    <menuitem 
        id="menu_import_products" 
        name="Importar Productos" 
        parent="stock.menu_stock_root"
        sequence="100"
        action="import_products_action"/>
        
    <record id="import_products_action" model="ir.actions.server">
        <field name="name">Importar Productos desde API</field>
        <field name="model_id" ref="model_product_import"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="state">code</field>
        <field name="code">
            model.import_products_from_api()
        </field>
    </record>
</odoo>