<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Añadir botones al portal principal -->
        <template id="portal_my_home_inherit" inherit_id="portal.portal_my_home">
            <xpath expr="//div[hasclass('o_portal_my_home')]" position="inside">
                <div class="o_portal_category row g-2 mt-3">
                    <div class="col-lg-6 col-md-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-handshake-o fa-3x mb-3 text-primary"/>
                                <h5 class="card-title">Oportunidades</h5>
                                <p class="card-text">Gestiona tus oportunidades de negocio</p>
                                <a href="/my/leads" class="btn btn-primary">Ver Oportunidades</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-calendar fa-3x mb-3 text-info"/>
                                <h5 class="card-title">Reuniones</h5>
                                <p class="card-text">Administra tus reuniones</p>
                                <a href="/my/meetings" class="btn btn-info">Ver Reuniones</a>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </template>

        <!-- Lista de oportunidades -->
        <template id="portal_my_leads" name="Portal My Leads">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Mis Oportunidades</t>
                </t>
                <div class="oe_structure">
                    <div class="container">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h1>Oportunidades</h1>
                                    <a href="/my/leads/create" class="btn btn-primary">
                                        <i class="fa fa-plus"/> Nueva Oportunidad
                                    </a>
                                </div>

                                <t t-if="leads">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Nombre</th>
                                                    <th>Etapa</th>
                                                    <th class="text-end">Ingresos Esperados</th>
                                                    <th class="text-end">Fecha</th>
                                                    <th class="text-end">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="leads" t-as="lead">
                                                    <tr>
                                                        <td>
                                                            <a t-attf-href="/my/leads/detail/#{lead.id}" class="text-decoration-none">
                                                                <strong t-esc="lead.name"/>
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <span t-if="lead.stage_id" class="badge bg-secondary" t-esc="lead.stage_id.name"/>
                                                            <span t-else="" class="text-muted">Sin etapa</span>
                                                        </td>
                                                        <td class="text-end">
                                                            <t t-if="lead.expected_revenue">
                                                                <span t-esc="lead.expected_revenue" t-options='{"widget": "monetary", "display_currency": user.company_id.currency_id}'/>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="text-muted">$0.00</span>
                                                            </t>
                                                        </td>
                                                        <td class="text-end">
                                                            <small t-esc="lead.create_date.strftime('%d/%m/%Y')" class="text-muted"/>
                                                        </td>
                                                        <td class="text-end">
                                                            <div class="btn-group btn-group-sm">
                                                                <a t-attf-href="/my/leads/detail/#{lead.id}" class="btn btn-outline-secondary" title="Ver">
                                                                    <i class="fa fa-eye"/>
                                                                </a>
                                                                <a t-attf-href="/my/leads/edit/#{lead.id}" class="btn btn-outline-warning" title="Editar">
                                                                    <i class="fa fa-edit"/>
                                                                </a>
                                                                <form t-attf-action="/my/leads/delete/#{lead.id}" method="post" style="display:inline-block;" onsubmit="return confirm('¿Estás seguro de eliminar esta oportunidad?')">
                                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                                                        <i class="fa fa-trash"/>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                    
                                    <!-- Paginación -->
                                    <t t-if="pager">
                                        <div class="d-flex justify-content-center">
                                            <t t-call="portal.pager"/>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-info text-center" role="alert">
                                        <i class="fa fa-info-circle fa-2x mb-2"/>
                                        <h5>No tienes oportunidades</h5>
                                        <p>Comienza creando tu primera oportunidad de negocio.</p>
                                        <a href="/my/leads/create" class="btn btn-primary">Crear Oportunidad</a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Detalle de oportunidad -->
        <template id="portal_my_lead_detail" name="Portal My Lead Detail">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Detalle de Oportunidad</t>
                </t>
                <div class="oe_structure">
                    <div class="container">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h2 class="mb-0" t-esc="lead.name"/>
                                        <div class="btn-group">
                                            <a t-attf-href="/my/leads/edit/#{lead.id}" class="btn btn-warning">
                                                <i class="fa fa-edit"/> Editar
                                            </a>
                                            <a href="/my/leads" class="btn btn-secondary">
                                                <i class="fa fa-arrow-left"/> Volver
                                            </a>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <table class="table table-borderless">
                                                    <tr>
                                                        <th width="40%">Etapa:</th>
                                                        <td>
                                                            <span t-if="lead.stage_id" class="badge bg-secondary" t-esc="lead.stage_id.name"/>
                                                            <span t-else="" class="text-muted">Sin etapa</span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>Ingresos Esperados:</th>
                                                        <td>
                                                            <strong t-esc="lead.expected_revenue" t-options='{"widget": "monetary", "display_currency": user.company_id.currency_id}'/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>Responsable:</th>
                                                        <td t-esc="lead.user_id.name if lead.user_id else 'Sin asignar'"/>
                                                    </tr>
                                                </table>
                                            </div>
                                            <div class="col-md-6">
                                                <table class="table table-borderless">
                                                    <tr>
                                                        <th width="40%">Cliente:</th>
                                                        <td t-esc="lead.partner_id.name if lead.partner_id else 'Sin cliente'"/>
                                                    </tr>
                                                    <tr>
                                                        <th>Fecha de Creación:</th>
                                                        <td t-esc="lead.create_date.strftime('%d/%m/%Y %H:%M')"/>
                                                    </tr>
                                                    <tr>
                                                        <th>Última Actualización:</th>
                                                        <td t-esc="lead.write_date.strftime('%d/%m/%Y %H:%M')"/>
                                                    </tr>
                                                </table>
                                            </div>
                                        </div>
                                        
                                        <!-- Descripción si existe -->
                                        <t t-if="lead.description">
                                            <hr/>
                                            <h5>Descripción:</h5>
                                            <p t-esc="lead.description"/>
                                        </t>
                                    </div>
                                    <div class="card-footer text-end">
                                        <form t-attf-action="/my/leads/delete/#{lead.id}" method="post" style="display:inline-block;" onsubmit="return confirm('¿Estás seguro de eliminar esta oportunidad?')">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-danger">
                                                <i class="fa fa-trash"/> Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Formulario de oportunidad -->
        <template id="portal_my_lead_form" name="Portal My Lead Form">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title"><t t-if="lead">Editar</t><t t-else="">Crear</t> Oportunidad</t>
                </t>
                <div class="oe_structure">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div class="card">
                                    <div class="card-header">
                                        <h3 class="mb-0">
                                            <i class="fa fa-handshake-o"/>
                                            <t t-if="lead">Editar Oportunidad</t>
                                            <t t-else="">Nueva Oportunidad</t>
                                        </h3>
                                    </div>
                                    <div class="card-body">
                                        <!-- Mostrar errores -->
                                        <t t-if="error">
                                            <div class="alert alert-danger">
                                                <ul class="mb-0">
                                                    <t t-foreach="error.items()" t-as="item">
                                                        <li><t t-esc="item[1]"/></li>
                                                    </t>
                                                </ul>
                                            </div>
                                        </t>
                                        
                                        <form t-attf-action="/my/leads/save#{('/' + str(lead.id)) if lead else ''}" method="post" class="o_portal_form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            
                                            <div class="mb-3">
                                                <label for="name" class="form-label">
                                                    Nombre de la Oportunidad <span class="text-danger">*</span>
                                                </label>
                                                <input type="text" 
                                                       name="name" 
                                                       id="name" 
                                                       class="form-control" 
                                                       t-att-value="lead.name if lead else ''" 
                                                       required="required"/>
                                            </div>

                                            <div class="mb-3">
                                                <label for="expected_revenue" class="form-label">Ingresos Esperados</label>
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input type="number" 
                                                           name="expected_revenue" 
                                                           id="expected_revenue" 
                                                           class="form-control" 
                                                           t-att-value="lead.expected_revenue if lead else '0'" 
                                                           step="0.01" 
                                                           min="0"/>
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label for="stage_id" class="form-label">Etapa</label>
                                                <select name="stage_id" id="stage_id" class="form-control">
                                                    <option value="">-- Seleccionar Etapa --</option>
                                                    <t t-foreach="stages" t-as="stage">
                                                        <option t-att-value="stage.id" 
                                                                t-att-selected="lead and lead.stage_id and lead.stage_id.id == stage.id">
                                                            <t t-esc="stage.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                            
                                            <div class="d-flex justify-content-between">
                                                <a href="/my/leads" class="btn btn-secondary">
                                                    <i class="fa fa-times"/> Cancelar
                                                </a>
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="fa fa-save"/> Guardar
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Lista de reuniones -->
        <template id="portal_my_meetings" name="Portal My Meetings">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Mis Reuniones</t>
                </t>
                <div class="oe_structure">
                    <div class="container">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h1>Reuniones</h1>
                                    <a href="/my/meetings/create" class="btn btn-primary">
                                        <i class="fa fa-plus"/> Nueva Reunión
                                    </a>
                                </div>

                                <t t-if="meetings">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Asunto</th>
                                                    <th>Fecha y Hora</th>
                                                    <th class="text-end">Duración</th>
                                                    <th class="text-end">Asistentes</th>
                                                    <th class="text-end">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="meetings" t-as="meeting">
                                                    <tr>
                                                        <td>
                                                            <a t-attf-href="/my/meetings/detail/#{meeting.id}" class="text-decoration-none">
                                                                <strong t-esc="meeting.name"/>
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <t t-if="meeting.start">
                                                                <span t-esc="meeting.start.strftime('%d/%m/%Y %H:%M')"/>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="text-muted">Sin fecha</span>
                                                            </t>
                                                        </td>
                                                        <td class="text-end">
                                                            <span t-esc="meeting.duration"/> horas
                                                        </td>
                                                        <td class="text-end">
                                                            <span class="badge bg-info" t-esc="len(meeting.partner_ids)"/>
                                                        </td>
                                                        <td class="text-end">
                                                            <div class="btn-group btn-group-sm">
                                                                <a t-attf-href="/my/meetings/detail/#{meeting.id}" class="btn btn-outline-secondary" title="Ver">
                                                                    <i class="fa fa-eye"/>
                                                                </a>
                                                                <a t-attf-href="/my/meetings/edit/#{meeting.id}" class="btn btn-outline-warning" title="Editar">
                                                                    <i class="fa fa-edit"/>
                                                                </a>
                                                                <form t-attf-action="/my/meetings/delete/#{meeting.id}" method="post" style="display:inline-block;" onsubmit="return confirm('¿Estás seguro de eliminar esta reunión?')">
                                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                                                        <i class="fa fa-trash"/>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                    
                                    <!-- Paginación -->
                                    <t t-if="pager">
                                        <div class="d-flex justify-content-center">
                                            <t t-call="portal.pager"/>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-info text-center" role="alert">
                                        <i class="fa fa-calendar fa-2x mb-2"/>
                                        <h5>No tienes reuniones</h5>
                                        <p>Programa tu primera reunión.</p>
                                        <a href="/my/meetings/create" class="btn btn-primary">Crear Reunión</a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Detalle de reunión -->
        <template id="portal_my_meeting_detail" name="Portal My Meeting Detail">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Detalle de Reunión</t>
                </t>
                <div class="oe_structure">
                    <div class="container">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h2 class="mb-0" t-esc="meeting.name"/>
                                        <div class="btn-group">
                                            <a t-attf-href="/my/meetings/edit/#{meeting.id}" class="btn btn-warning">
                                                <i class="fa fa-edit"/> Editar
                                            </a>
                                            <a href="/my/meetings" class="btn btn-secondary">
                                                <i class="fa fa-arrow-left"/> Volver
                                            </a>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <table class="table table-borderless">
                                                    <tr>
                                                        <th width="40%">Fecha y Hora:</th>
                                                        <td>
                                                            <t t-if="meeting.start">
                                                                <strong t-esc="meeting.start.strftime('%d/%m/%Y %H:%M')"/>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="text-muted">Sin fecha</span>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>Duración:</th>
                                                        <td><strong t-esc="meeting.duration"/> horas</td>
                                                    </tr>
                                                    <tr>
                                                        <th>Estado:</th>
                                                        <td>
                                                            <span class="badge bg-success">Programada</span>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                            <div class="col-md-6">
                                                <h5>Asistentes:</h5>
                                                <ul class="list-group list-group-flush">
                                                    <t t-foreach="meeting.partner_ids" t-as="partner">
                                                        <li class="list-group-item d-flex align-items-center">
                                                            <i class="fa fa-user me-2"/>
                                                            <span t-esc="partner.name"/>
                                                        </li>
                                                    </t>
                                                </ul>
                                            </div>
                                        </div>
                                        
                                        <!-- Descripción si existe -->
                                        <t t-if="meeting.description">
                                            <hr/>
                                            <h5>Descripción:</h5>
                                            <p t-esc="meeting.description"/>
                                        </t>
                                    </div>
                                    <div class="card-footer text-end">
                                        <form t-attf-action="/my/meetings/delete/#{meeting.id}" method="post" style="display:inline-block;" onsubmit="return confirm('¿Estás seguro de eliminar esta reunión?')">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-danger">
                                                <i class="fa fa-trash"/> Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Formulario de reunión -->
        <template id="portal_my_meeting_form" name="Portal My Meeting Form">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title"><t t-if="meeting">Editar</t><t t-else="">Crear</t> Reunión</t>
                </t>
                <div class="oe_structure">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div class="card">
                                    <div class="card-header">
                                        <h3 class="mb-0">
                                            <i class="fa fa-calendar"/>
                                            <t t-if="meeting">Editar Reunión</t>
                                            <t t-else="">Nueva Reunión</t>
                                        </h3>
                                    </div>
                                    <div class="card-body">
                                        <!-- Mostrar errores -->
                                        <t t-if="error">
                                            <div class="alert alert-danger">
                                                <ul class="mb-0">
                                                    <t t-foreach="error.items()" t-as="item">
                                                        <li><t t-esc="item[1]"/></li>
                                                    </t>
                                                </ul>
                                            </div>
                                        </t>
                                        
                                        <form t-attf-action="/my/meetings/save#{('/' + str(meeting.id)) if meeting else ''}" method="post" class="o_portal_form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            
                                            <div class="mb-3">
                                                <label for="name" class="form-label">
                                                    Asunto <span class="text-danger">*</span>
                                                </label>
                                                <input type="text" 
                                                       name="name" 
                                                       id="name" 
                                                       class="form-control" 
                                                       t-att-value="meeting.name if meeting else ''" 
                                                       required="required"/>
                                            </div>

                                            <div class="mb-3">
                                                <label for="start_datetime" class="form-label">
                                                    Fecha y Hora de Inicio <span class="text-danger">*</span>
                                                </label>
                                                <input type="datetime-local" 
                                                       name="start_datetime" 
                                                       id="start_datetime" 
                                                       class="form-control"
                                                       t-att-value="meeting.start.strftime('%Y-%m-%dT%H:%M') if meeting and meeting.start else ''" 
                                                       required="required"/>
                                            </div>

                                            <div class="mb-3">
                                                <label for="duration" class="form-label">Duración (horas)</label>
                                                <input type="number" 
                                                       name="duration" 
                                                       id="duration" 
                                                       class="form-control" 
                                                       t-att-value="meeting.duration if meeting else '1.0'" 
                                                       step="0.5" 
                                                       min="0.5"/>
                                            </div>

                                            <div class="mb-3">
                                                <label for="partner_ids" class="form-label">Asistentes</label>
                                                <select name="partner_ids" id="partner_ids" class="form-control" multiple="multiple" size="5">
                                                    <t t-foreach="partners" t-as="partner">
                                                        <option t-att-value="partner.id" 
                                                                t-att-selected="meeting and partner in meeting.partner_ids">
                                                            <t t-esc="partner.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                                <div class="form-text">
                                                    Mantén presionado Ctrl (Windows) o Cmd (Mac) para seleccionar múltiples asistentes. 
                                                    Tu contacto se añadirá automáticamente.
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between">
                                                <a href="/my/meetings" class="btn btn-secondary">
                                                    <i class="fa fa-times"/> Cancelar
                                                </a>
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="fa fa-save"/> Guardar
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>