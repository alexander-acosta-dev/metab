<odoo>
    <!-- Vista principal para la importación -->
    <record id="view_product_api_import" model="ir.ui.view">
        <field name="name">product.api.import.view</field>
        <field name="model">product.api.import</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Importar Productos desde API</h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="button_import_products" type="object" class="btn-primary">
                            Consumir API
                        </button>
                    </div>
                    <div id="import_results" class="mt16"></div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_product_api_import" model="ir.actions.act_window">
        <field name="name">Importar Productos API</field>
        <field name="res_model">product.api.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú principal - Ubicado dentro de Inventario -->
    <menuitem 
        id="menu_product_api_import" 
        name="Importar Productos" 
        action="action_product_api_import" 
        parent="stock.menu_stock_root"
        sequence="100"
    />
</odoo>