<odoo>
    <!-- Vista de importación de productos -->
    <record id="view_product_api_import_form" model="ir.ui.view">
        <field name="name">product.api.import.form</field>
        <field name="model">product.api.import</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="picking_type_id" 
                               options="{'no_open': True}" 
                               attrs="{'required': [('id', '!=', False)]}"/>
                    </group>
                    <footer>
                        <button name="button_import_products" 
                                type="object" 
                                string="Importar" 
                                class="btn-primary"/>
                        <button string="Cancelar" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_product_api_import" model="ir.actions.act_window">
        <field name="name">Importar desde API</field>
        <field name="res_model">product.api.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_picking_type_id': active_id}</field>
    </record>
</odoo>